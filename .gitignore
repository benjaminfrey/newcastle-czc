# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Editors / IDEs
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/

# Environment / secrets
.env
.env.local
.env.*.local

# Logs
*.log

# Python (extraction pipeline)
__pycache__/
*.pyc

# Scratch / working review artifacts (not deliverables)
review-d1/
extract/_*

# Generated release PDFs — large and fully regenerable from git tags + build
# scripts, so track only the text record (markdown + Summaries). The immutable
# baseline PDFs in docs/ and the analysis PDFs in memos/ are NOT matched here and
# stay tracked. (Already-committed release PDFs, e.g. v0.21, remain tracked until
# explicitly removed; this stops *new* release PDFs from being committed.)
releases/**/*.pdf

# Inventory-editor safety copies. The editor (build/inventory-editor/serve.py)
# writes a timestamped backup beside each data file before every save and keeps
# the 10 newest; the .tmp- files are the atomic-write staging files. Neither is
# a deliverable — the durable record is the committed overrides.json itself.
build/street-types/*.bak-*
build/street-types/*.tmp-*
source/exhibits/street-types/*.bak-*
source/exhibits/street-types/*.tmp-*
build/permit-review/data/
build/permit-review/.venv/
