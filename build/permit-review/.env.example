# Newcastle Permit Review — environment (all optional; sane defaults apply).
# Copy to .env if you use a loader, or export these directly. Nothing here is
# required to run `python3 run.py` or `python3 run.py --selftest`.
#
# NOT here: the bound HOST (always 127.0.0.1, a fixed module constant) and
# PORT (default 8781) are deliberately NOT environment-configurable —
# CONTRACT.md §1 S3 / app/config.py. To change the port, use the CLI flag:
#     python3 run.py --port 8900

# Points DATA_DIR (and everything under it: the SQLite DB, blobs/, exports/,
# tmp/) somewhere other than build/permit-review/data/. Mainly a tests-only
# escape hatch (app/config.py:_env_path()).
# PERMIT_REVIEW_DATA_DIR=/tmp/permit-review-data

# Free-form; not read by any safety check. Defaults to "development".
# PERMIT_REVIEW_ENV=development

# Log verbosity. Defaults to "INFO".
# PERMIT_REVIEW_LOG_LEVEL=INFO

# Which llm/ provider llm/factory.py:get_client() constructs. Defaults to
# "null" (deterministic, offline, zero-cost) -- this is deliberate, so
# nothing in this app reaches for a key or a network socket unless a human
# explicitly opts in here. One of: null | anthropic | recorded | local.
# Setting this to "anthropic" also requires ANTHROPIC_API_KEY (below) --
# read at call time only, never stored -- or every call fails with
# LLMAuthError before any request is sent.
# PERMIT_REVIEW_LLM_PROVIDER=null

# Only read by llm/anthropic_provider.py, only when
# PERMIT_REVIEW_LLM_PROVIDER=anthropic, and only at the moment of each
# call -- never stored, never logged, never written to an `events` row.
# Leave unset for offline/default operation; --selftest and the test suite
# never require it and must keep passing without it.
# ANTHROPIC_API_KEY=
