# Copy to .env (gitignored) on the VM and fill in.
PORTAL_HOST=permits-dev.example.org
# Leave empty for a public host name (Caddy gets a Let's Encrypt certificate).
# Set to "tls internal" for an IP address or a name only your network resolves.
PORTAL_TLS=
# Empty publishes 80/443 on every interface. 127.0.0.1 keeps a trial run on the VM only.
PORTAL_BIND=
POSTGRES_PASSWORD=change-me
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_FROM=Town of Newcastle Permits <permits@example.org>
# The upload store's credentials (the API and the store service share them). Letters and digits only.
STORE_ACCESS_KEY=portal
STORE_SECRET_KEY=change-me-to-a-long-random-string
# Optional: an external S3-compatible endpoint (S3, R2) instead of the store service.
# S3_ENDPOINT=
# Only with compose.lan.yml (development on the LAN): Mailpit's web view login, user:password.
MAILPIT_UI_AUTH=dev:change-me
