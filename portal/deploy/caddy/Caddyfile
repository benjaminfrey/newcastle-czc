{
	# Clients connecting to a bare IP address send no SNI; without this Caddy
	# cannot pick a certificate and the TLS handshake fails.
	default_sni {$PORTAL_HOST}
}

{$PORTAL_HOST} {
	{$PORTAL_TLS}
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
	}
	# Uploads: 25 MB files plus multipart framing (the API checks the exact limit).
	# Every other API request is small. (MiB, not MB: Caddy reads MB as 1,000,000.)
	@uploads path_regexp ^/api/applications/[^/]+/attachments$
	handle @uploads {
		request_body {
			max_size 26MiB
		}
		reverse_proxy api:8000
	}
	handle /api/* {
		request_body {
			max_size 4MiB
		}
		reverse_proxy api:8000
	}
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
