{
	# Clients connecting to a bare IP address send no SNI; without this Caddy
	# cannot pick a certificate and the TLS handshake fails.
	default_sni {$PORTAL_HOST}
}

{$PORTAL_HOST} {
	{$PORTAL_TLS}
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
	}
	handle /api/* {
		reverse_proxy api:8000
	}
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
